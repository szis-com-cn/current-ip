# 加密通信密钥
CRYPTO_SECRET_KEY=test_secret_key_123456
# 日志文件路径（容器内路径，默认 /app/logs/webhook.log）
LOG_FILE=/app/logs/webhook.log
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
# 日志轮转大小（字节）
LOG_MAX_SIZE=10485760
# 日志备份文件个数
LOG_BACKUP_COUNT=5
# Nginx 配置文件路径
NGINX_CONFIG_PATH=/etc/nginx/conf.d/allowed_ips.conf
