# Webhook服务配置
TZ=Asia/Shanghai

# 日志配置
LOG_FILE=/app/logs/webhook.log
LOG_LEVEL=INFO
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Nginx配置
# 配置文件路径 - 指向nginx-data目录下的allowed_ips.conf
NGINX_CONFIG_PATH=/nginx-data/allowed_ips.conf
# 重载方法 - 使用command方式（避免docker命令依赖）
NGINX_RELOAD_METHOD=command
# 外部nginx容器名称
NGINX_CONTAINER_NAME=nginx容器名
# nginx重载命令 - 使用 docker exec 直接执行重载
NGINX_RELOAD_COMMAND=docker exec nginx容器名 nginx -s reload