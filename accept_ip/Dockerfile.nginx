FROM nginx:alpine

# 复制Nginx配置文件
COPY nginx.conf /etc/nginx/nginx.conf

# 创建空的允许IP配置文件
RUN echo "# 允许访问的IP地址列表" > /etc/nginx/conf.d/allowed_ips.conf && \
    echo "deny all;" >> /etc/nginx/conf.d/allowed_ips.conf

# 创建一个简单的HTML页面用于测试
RUN echo "<!DOCTYPE html><html><body><h1>限定IP访问中</h1></body></html>" > /usr/share/nginx/html/index.html